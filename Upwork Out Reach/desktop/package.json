{
  "name": "upwork-outreach-desktop",
  "productName": "Upwork Outreach",
  "version": "1.0.0",
  "description": "Outreach Contacts desktop app",
  "author": "Upwork Outreach",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-app": "node prepare.mjs",
    "start": "node prepare.mjs && electron .",
    "dist": "node prepare.mjs && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.upworkoutreach.contacts",
    "productName": "Upwork Outreach",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "package.json",
      "bundle/**",
      "build/icon.png"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Upwork Outreach",
      "runAfterFinish": true,
      "artifactName": "UpworkOutreach-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}
