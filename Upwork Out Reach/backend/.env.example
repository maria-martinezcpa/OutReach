# Drafting uses your local Claude Code login — no API key needed.
PORT=8787
# Optional: path to claude.exe if it isn't found automatically
# CLAUDE_PATH=C:\Users\you\.local\bin\claude.exe
# Optional: model override (default = Claude Code's default model)
# CLAUDE_MODEL=claude-opus-5-5
# Optional: lock CORS to your extension (chrome://extensions shows the ID)
# ALLOWED_EXTENSION_ID=abcdefghijklmnopabcdefghijklmnop
