# GitHub personal access token (classic, no scopes needed for public data; fine-grained with public read-only also works).
# Without a token GitHub allows only 60 requests/hour, which is not enough for a single search.
GITHUB_TOKEN=
# Hours before cached GitHub data is fetched again.
CACHE_TTL_HOURS=24
# Repositories per profile checked for commits in the search period (each costs one API request).
PERIOD_REPO_CHECK_LIMIT=6
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional GitHub App (higher rate limits). Can also be set up on the Tokens page.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
