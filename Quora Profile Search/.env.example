# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5

# --- Search engine API (pick one). Free plans: tavily, serper ---
SEARCH_PROVIDER=tavily             # tavily | serper | brave | google
TAVILY_API_KEY=                    # https://app.tavily.com  (free monthly credits)
SERPER_API_KEY=                    # https://serper.dev      (free sign-up credits)
BRAVE_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Reddit official Data API (create a "script"/"web" app at https://www.reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:contact-discovery:1.0 (by /u/your_reddit_username)
REDDIT_DEFAULT_SUBREDDITS=forhire,freelance_forhire,hireaprogrammer,jobbit

# --- Optional ---
GITHUB_TOKEN=                      # raises GitHub API rate limits; public data only
POSTGRES_PASSWORD=quora
MAX_CANDIDATES_PER_SEARCH=15

# Local dev without Docker:
# DATABASE_URL=sqlite:///./dev.db
# CELERY_BROKER_URL=               # empty = run searches in-process
